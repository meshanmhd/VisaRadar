# Copy this to .env and fill in your values

# App
APP_ENV=development
SECRET_KEY=change-me-in-production

# Database (Neon PostgreSQL or SQLite)
# Neon PostgreSQL example:
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./nova.db

# LLM (used by LangGraph ClassifierAgent to classify visa/policy changes)
# Supported: groq (free), google (free tier), openai, anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative free Groq model: GROQ_MODEL=llama-3.1-8b-instant

# OR use Google Gemini (free tier available)
# LLM_PROVIDER=google
# GOOGLE_API_KEY=...

# OR use OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Scraping targets (pre-configured to UK gov.uk)
UK_VISA_URL=https://ukclone.vercel.app
UK_VISA_POLICY_URL=https://www.gov.uk/government/collections/visa-regulations-revised-rules

# Alert system (optional email/webhook)
ALERT_EMAIL_ENABLED=false
ALERT_WEBHOOK_URL=

# Scheduler: every 6 hours (cron: 0 */6 * * *)
SCRAPE_CRON=0 */6 * * *
